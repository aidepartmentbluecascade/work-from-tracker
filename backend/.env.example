# PostgreSQL connection. postgres://, postgresql:// and postgresql+psycopg:// all work.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# All app tables are created inside this schema (safe to share a database with other apps).
DB_SCHEMA=wfh

# JWT signing secret - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=720

# Google Cloud Storage (bucket should be private; admins see screenshots via signed URLs)
GCS_BUCKET=your-bucket-name
GCS_PROJECT_ID=your-project-id
GCS_SIGNED_URL_MINUTES=30
# Option A (recommended, works on Render): whole service-account JSON in one line, single-quoted in .env
GOOGLE_CREDENTIALS_JSON='{"type":"service_account", ...}'
# Option B: path to the JSON key file
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

MAX_UPLOAD_MB=10

# First admin, created automatically on startup if no admin exists
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe123!
FIRST_ADMIN_NAME=Administrator
